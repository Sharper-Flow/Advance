{
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/Advance/trunk/plugin/schemas/backlog-item.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "archived_at": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "promoted_to": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "change",
            "epic_shell"
          ],
          "type": "string"
        },
        "promoted_at": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "promoted_at"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ],
      "type": "string"
    },
    "success_hint": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "success_hint",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "ADV Repo Backlog Item",
  "type": "object"
}
