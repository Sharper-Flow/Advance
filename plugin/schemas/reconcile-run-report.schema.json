{
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/Advance/trunk/plugin/schemas/reconcile-run-report.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "counters": {
      "properties": {
        "failed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mutated": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mutated",
        "skipped",
        "failed"
      ],
      "type": "object"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "interrupted": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "dry_run",
        "execute"
      ],
      "type": "string"
    },
    "proof": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "records": {
      "items": {
        "properties": {
          "action": {
            "type": "string"
          },
          "after_hash": {
            "type": "string"
          },
          "before_hash": {
            "type": "string"
          },
          "class": {
            "enum": [
              "schema_drift_retired_enum",
              "summary_pointer_missing",
              "summary_pointer_stale",
              "legacy_divergent_behind",
              "legacy_newer_than_canonical",
              "unmigrated_artifact_metadata",
              "unmigrated_worktree_marker",
              "epic_owner_missing",
              "quarantined_record",
              "unknown_store_noise",
              "store_artifact_missing",
              "healthy"
            ],
            "type": "string"
          },
          "error_class": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "mutated",
              "skipped",
              "failed"
            ],
            "type": "string"
          },
          "ts": {
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "class",
          "action",
          "status",
          "ts"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "residuals": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "started_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "started_at",
    "finished_at",
    "interrupted",
    "records",
    "counters",
    "residuals"
  ],
  "title": "ADV Reconcile Run Report",
  "type": "object"
}
