{
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/Advance/trunk/plugin/schemas/release-notes.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Versioned release-notes archive envelope. Runtime validation also rejects a serialized UTF-8 envelope larger than 32768 bytes; this byte limit is not representable in JSON Schema.",
  "properties": {
    "change_id": {
      "type": "string"
    },
    "release_notes": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "maxLength": 100,
          "type": "string"
        },
        "audience": {
          "enum": [
            "external",
            "internal",
            "both"
          ],
          "type": "string"
        },
        "breaking": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "maxLength": 2048,
              "type": "string"
            },
            "migration": {
              "maxLength": 4096,
              "type": "string"
            }
          },
          "required": [
            "description"
          ],
          "type": "object"
        },
        "category": {
          "enum": [
            "added",
            "changed",
            "deprecated",
            "removed",
            "fixed",
            "security"
          ],
          "type": "string"
        },
        "deprecations": {
          "items": {
            "maxLength": 2048,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "headline_external": {
          "maxLength": 2048,
          "type": "string"
        },
        "headline_internal": {
          "maxLength": 2048,
          "type": "string"
        },
        "highlights": {
          "items": {
            "maxLength": 2048,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "links": {
          "additionalProperties": false,
          "properties": {
            "issue": {
              "type": "string"
            },
            "pr": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "user_action_required": {
          "type": "boolean"
        }
      },
      "required": [
        "audience",
        "category"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "change_id",
    "title",
    "release_notes"
  ],
  "title": "ADV Release Notes Archive Envelope",
  "type": "object"
}
